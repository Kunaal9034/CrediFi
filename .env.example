# JusticeVault Monorepo Environment Variables Overview
# Copy and configure the corresponding .env files in blockchain/, server/, and client/

# Server (.env in server/)
# PORT=5000
# NODE_ENV=development
# MONGODB_URI=
# JWT_SECRET=
# AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# CONTRACT_ADDRESS=
# OPERATOR_PRIVATE_KEY=
# MAX_UPLOAD_SIZE_MB=500

# Blockchain (.env in blockchain/)
# AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# OPERATOR_PRIVATE_KEY=
# POLYGONSCAN_API_KEY=

# Client (.env in client/)
# VITE_API_URL=http://localhost:5000/api
# VITE_CHAIN_ID=80002
# VITE_CHAIN_NAME="Polygon Amoy Testnet"
# VITE_RPC_URL=https://rpc-amoy.polygon.technology
# VITE_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
# VITE_CONTRACT_ADDRESS=

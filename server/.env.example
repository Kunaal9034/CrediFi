PORT=5000
NODE_ENV=development

# Database configuration (leave blank or specify MongoDB Atlas URI)
# If left empty, will automatically use embedded memory database for local development
MONGODB_URI=

# Security
JWT_SECRET=justicevault_secure_jwt_production_secret_key_2026
JWT_EXPIRES_IN=24h

# Blockchain Configuration (Polygon Amoy Testnet)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=
OPERATOR_PRIVATE_KEY=

# Storage (Optional Pinata IPFS; fallback to local content-addressed storage)
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

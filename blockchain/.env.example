# Polygon Amoy Testnet RPC
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Relayer & Deployer Private Key (Keep strictly confidential, funded with Amoy POL)
# Supported keys: OPERATOR_PRIVATE_KEY or PRIVATE_KEY
OPERATOR_PRIVATE_KEY=your_amoy_operator_private_key_here
PRIVATE_KEY=your_amoy_operator_private_key_here

# Optional: Polygonscan API Key for contract verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
